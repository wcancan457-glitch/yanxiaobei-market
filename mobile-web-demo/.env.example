# Runtime uses a restricted DML-only role. Keep the owner connection out of the app service.
DATABASE_URL=postgresql://yanxiaobei_app.PROJECT_REF:APP_ROLE_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Used only by migration/role-configuration commands, never persisted in the app service.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:OWNER_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_DATABASE_URL=postgresql://yanxiaobei_app.PROJECT_REF:APP_ROLE_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=10
PORT=5177
AUTH_TOKEN_SECRET=replace-with-a-random-64-character-secret
APP_BASE_URL=https://yanxiaobei.wangpangxie.top

# Optional until a mail provider is connected. Without these values, an
# administrator can still manually verify an account, but email verification
# and password recovery cannot send codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
MAIL_FROM=燕小北集市 <mailer@example.com>
